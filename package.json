{
  "name": "thiet-ke-website-chuyen-nghiep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "dev:app-khach": "node scripts/dev-app-khach.mjs",
    "apk:khach": "node --experimental-strip-types --no-warnings scripts/build-customer-apk.mts",
    "build:render-app": "node scripts/build-github-app-khach.mjs",
    "cap:sync": "node scripts/build-github-app-khach.mjs && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:android": "node scripts/build-github-app-khach.mjs && npx cap sync android && npx cap open android",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "start:prod": "next start --hostname 0.0.0.0 --port 3000",
    "start:cloudflare": "node scripts/start-cloudflare.mjs",
    "server:start": "node scripts/server-watchdog.mjs",
    "server:install": "node scripts/install-autostart.mjs",
    "server:uninstall": "node scripts/uninstall-autostart.mjs",
    "lint": "eslint"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
