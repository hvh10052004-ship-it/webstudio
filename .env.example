DATABASE_PATH=./data/webstudio.db
SESSION_SECRET=doi-chuoi-nay-khi-chay-that
PORT=3000
HOSTNAME=0.0.0.0
# Dia chi HTTPS Cloudflare (dat khi chay tunnel 24/7)
# PUBLIC_ORIGIN=https://webstudio-app-khach.onrender.com
# Máy chủ riêng app khách (giao diện full màn hình, / mở thẳng app)
# APP_KHACH_SERVER=1
# NEXT_PUBLIC_APP_KHACH_SERVER=1
# APP_KHACH_STATIC=1
# COOKIE_SECURE=1
# Capacitor: mặc định mở máy chủ Render. Đổi URL nếu cần.
# Gmail gui ma dang ky (mat khau ung dung, khong phai mat khau dang nhap)
# GMAIL_USER=ban@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Dang nhap Google: tao OAuth client (Web) tai Google Cloud, redirect
# http://127.0.0.1:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Dang nhap iCloud (Sign in with Apple). Redirect
# http://127.0.0.1:3000/api/auth/apple/callback
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=


